            "learner",
            "{{learnerCode}}"
          ]
        },
        "description": "Also stores the first assessment id in {{assessmentId}} for E3."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json();",
              "if (Array.isArray(d) && d.length) { pm.environment.set('assessmentId', d[0].id); }"
            ]
          }
        }
      ]
    },
