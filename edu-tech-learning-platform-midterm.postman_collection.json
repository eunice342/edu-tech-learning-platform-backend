    {
      "name": "D1 - safe saving",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/lessons/save",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "lessons",
            "save"
          ]
        },
        "description": "Success: 201 and status is REQUESTED even though the body says TAUGHT. Errors: set lessonDate to 2020-01-01 -> 400 'Lesson date cannot be in the past'; send the same tutor+date twice -> 409 'Tutor already has a lesson on that date'.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lessonDate\": \"{{futureDate}}\",\n  \"status\": \"TAUGHT\",\n  \"topic\": \"Trigonometry\",\n  \"durationMinutes\": 60,\n  \"learner\": {\n    \"id\": \"{{learnerId}}\"\n  },\n  \"tutor\": {\n    \"id\": \"{{tutorId}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "D2 - status flow",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/lessons/{{lessonRequestedId}}/status?status=ACCEPTED",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "lessons",
            "{{lessonRequestedId}}",
            "status"
          ],
          "query": [
            {
              "key": "status",
              "value": "ACCEPTED"
            }
          ]
        },
        "description": "Success 200 first time. Error: PATCH {{lessonDeclinedId}} with status=REQUESTED -> 400 'Cannot change status from DECLINED to REQUESTED'."
      }
    },
    {
      "name": "D3 - add one subject to a tutor",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tutors/{{tutorId}}/subjects/{{csSubjectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tutors",
            "{{tutorId}}",
            "subjects",
            "{{csSubjectId}}"
          ]
        },
        "description": "200 first time; run again -> 409 'The tutor already has that subject'."
      }
    },
    {
      "name": "D4 - move a tutor to another studio",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tutors/{{tutor3Id}}/studio?studioNumber=4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tutors",
            "{{tutor3Id}}",
            "studio"
          ],
          "query": [
            {
              "key": "studioNumber",
              "value": "4"
            }
          ]
        },
        "description": "200 first time, then run C2 (studio 3 becomes free). Error: studioNumber=1 -> 409 'That studio is taken by another tutor'; studioNumber=99 -> 404."
      }
    },
    {
      "name": "E1 - write an assessment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assessments/save?lessonId={{lessonTaughtId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assessments",
            "save"
          ],
          "query": [
            {
              "key": "lessonId",
              "value": "{{lessonTaughtId}}"
            }
          ]
        },
        "description": "Error: use {{lessonRequestedId}} -> 400 'Assessments are only for TAUGHT lessons'.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"skill\": \"Problem solving\",\n  \"comment\": \"Solves quadratic equations confidently\",\n  \"score\": 85\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "E2 - assessment history of a learner",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/assessments/learner/{{learnerCode}}",
          "host": [
